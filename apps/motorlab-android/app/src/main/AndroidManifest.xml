<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:allowBackup="false"
        android:label="MotorLab"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".AutoSetupActivity" android:exported="false"/>
        <!-- External text shares are validated and then reviewed inside AutoSetup;
             never export its browser/activity or any credential-handling screen. -->
        <activity android:name=".AutoSetupShareReceiverActivity"
            android:exported="true"
            android:label="MotorLab AutoSetup - Checkpoint">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="application/json"/>
            </intent-filter>
        </activity>
        <activity android:name=".TeamArchiveActivity" android:exported="false"/>
        <activity android:name=".TeamChatActivity" android:exported="false"/>
        <activity android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
