{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "motorlab-state-bridge",
  "main": "src/entry.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motorlab-operational-state-db",
      "database_id": "9d94db34-2d3d-45be-8335-eae1b75d60b4"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "POLLICINO_SENTINEL",
        "class_name": "PollicinoSentinel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "pollicino-v1",
      "new_sqlite_classes": ["PollicinoSentinel"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "987774db498241aba75e6e30880dbb10"
    }
  ],
  "vars": {
    "ENGINE_VERSION": "1.3.5",
    "ALLOWED_REPOSITORY": "Br174/Chatgpt",
    "ALLOWED_REFS": "refs/heads/main,refs/heads/motorlab/cloudflare-state-r16",
    "RELAY_ISSUE_NUMBER": "1",
    "GITHUB_OIDC_AUDIENCE": "motorlab-state-bridge",
    "OIDC_ALLOWED_REPOSITORY": "Br174/Chatgpt",
    "OIDC_ALLOWED_REPOSITORY_ID": "1363281702",
    "OIDC_ALLOWED_REF": "refs/heads/main",
    "OIDC_ALLOWED_WORKFLOW_REF": "Br174/Chatgpt/.github/workflows/motorlab-d1-oidc-relay.yml@refs/heads/main",
    "MOTORLAB_AUTOSETUP_LIVE_GITHUB_WRITE": "false",
    "MOTORLAB_AUTOSETUP_PROBE_ONLY": "true",
    "MOTORLAB_AUTOSETUP_PROBE_UNTIL": "2026-10-13T21:58:31Z"
  },
  "previews": {
    "vars": {
      "ENGINE_VERSION": "1.3.5-lab06-preview",
      "MOTORLAB_AUTOSETUP_LIVE_GITHUB_WRITE": "false",
      "MOTORLAB_AUTOSETUP_PROBE_ONLY": "false"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "POLLICINO_SENTINEL",
          "class_name": "PollicinoSentinel"
        }
      ]
    }
  }
}
